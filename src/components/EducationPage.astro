---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

export interface Props {
  title: string;
  introduction: string;
  description: string;
  image: string;
  imageKey: `programImages.${number}`;
  points: string[];
}

const { title, introduction, description, image, imageKey, points }: Props = Astro.props;
const admissionHref = `${import.meta.env.BASE_URL}admision/`;
---
<Layout title={`${title} | Don Bosco de Esmeraldas`}>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">OFERTA EDUCATIVA</p>
        <h1>{title}</h1>
        <p>{introduction}</p>
      </div>
    </section>
    <section class="about container">
      <div class="about-image">
        <img src={image} alt={`Estudiantes de ${title}`} data-image-key={imageKey} />
      </div>
      <div class="about-copy">
        <p class="eyebrow">FORMACIÓN INTEGRAL</p>
        <h2>Crecer aprendiendo y compartiendo</h2>
        <p>{description}</p>
        <ul>
          {points.map((point) => <li>{point}</li>)}
        </ul>
        <a class="btn btn-primary" href={admissionHref}>Consultar admisión →</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>