---
import { siteLogo } from "../data/siteContent";

const base = import.meta.env.BASE_URL || "/";
const navItems = [
  { label: "Inicio", href: base },
  { label: "Institución", href: `${base}institucion/` },
  { label: "Autoridades", href: `${base}autoridades/` },
  { label: "Oferta Educativa", href: `${base}oferta-educativa/` },
  { label: "Cuadro de Honor", href: `${base}cuadro-de-honor/` },
  { label: "Noticias", href: `${base}noticias/` },
  { label: "Galería", href: `${base}galeria/` },
  { label: "Contacto", href: `${base}contacto/` }
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <a class="brand" href={base} aria-label="Inicio">
    <img src={siteLogo} alt="Logo Don Bosco" data-image-key="siteLogo" />
    <span>
      <small>UNIDAD EDUCATIVA</small>
      <strong>FISCOMISIONAL</strong>
      <b>DON BOSCO</b>
      <em>DE ESMERALDAS</em>
    </span>
  </a>

  <button class="menu-button" data-menu-button aria-label="Abrir menú" aria-expanded="false">☰</button>

  <nav class="main-nav" data-menu>
    {navItems.map((item) => (
      <a class:list={{ active: current === item.href || (item.href !== "/" && current.startsWith(item.href)) }} href={item.href}>
        {item.label}
      </a>
    ))}
  </nav>
</header>
