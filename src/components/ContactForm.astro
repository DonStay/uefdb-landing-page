---
const formUrl = "https://share.forms.app/plazakristhel/formulario-de-contacto-institucion-educativa";
---
<div class="contact-form-embed">
	<iframe
		class="forms-app-embed"
		title="Formulario de contacto de la institución educativa"
		src={formUrl}
		loading="lazy"
	></iframe>
	<a class="maps-link" href={formUrl} target="_blank" rel="noopener noreferrer">
		Abrir el formulario en forms.app
	</a>
</div>
